APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://followup:followup@db:5432/followup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Optional; rules mode makes zero OpenAI calls.
CLASSIFIER_MODE=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generate both with python scripts/setup.py after installing requirements.
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
DEFAULT_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
# Optional comma-separated account allowlist, recommended for internet deployments.
ALLOWED_EMAILS=
